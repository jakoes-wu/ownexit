# 复制到仓库外的绝对路径后填写真实值，并执行 chmod 600。
# 不允许引号、变量展开、前后空白、重复键或未知键。
CHAIN_ID=example-chain
RELAY_HOST=REPLACE_WITH_RELAY_IPV4
RELAY_SSH_PORT=22
RELAY_SSH_USER=root
RELAY_SSH_KEY=/ABSOLUTE/PATH/TO/RELAY_PRIVATE_KEY
EXIT_HOST=REPLACE_WITH_EXIT_IPV4
EXIT_SSH_PORT=22
EXIT_SSH_USER=root
EXIT_SSH_KEY=/ABSOLUTE/PATH/TO/EXIT_PRIVATE_KEY
EXPECTED_EXIT_IPV4=REPLACE_WITH_EXPECTED_EXIT_IPV4
REALITY_SERVER_NAME=www.amazon.com
RELAY_COHOSTS_SINGBOX=yes
# managed：部署时在出口机加 nft 白名单只放行中转；provider：服务商安全组只放行中转；none：不限制
EXIT_SOURCE_FILTER=managed
